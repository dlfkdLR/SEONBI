# docker-compose.yml 이 읽는 값 (로컬: 이 파일을 .env 로 복사 / Dokploy: Environment 탭에 입력)
POSTGRES_PASSWORD=change-me
LLM_MODEL_FAST=fake:default
LLM_MODEL_QUALITY=fake:default
# 실제 AI를 쓸 때: 제공자:모델명 으로 바꾸고 해당 키를 채운다 (예: gemini:gemini-3.1-flash-lite)
LLM_FALLBACK_MODELS=
LLM_ROUTES=
